# ---- Edit these, then run scripts/build.sh ----
# CLI / service / config-dir name (lowercase, no spaces). Replaces "netbird".
BRAND_NAME=slbzt
# Name shown in messages and as the Windows service display name.
BRAND_DISPLAY=SLBZT
# Your NetBird management server. Baked in as the default, so users never type it.
MGMT_URL=https://zt.skylinebiz.in:443
# Upstream NetBird release to build from.
NETBIRD_VERSION=v0.83.0
# Version string for your build.
BUILD_VERSION=1.1.0

# --- Coexistence with a stock NetBird install (must differ from NetBird's wt0 / utun100 / 51820) ---
WG_IFACE=slbzt0
WG_IFACE_DARWIN=utun150
WG_PORT=51821

# Windows 7/8 build: community-patched Go toolchain tag (https://github.com/thongtech/go-legacy-win7). Empty = skip.
WIN7_GO_TAG=v1.26.10-1
WG_GUID_WINDOWS={7ad4dd62-51f0-4708-a0cd-c60a91e9be47}

# Where the built files are published (the Linux setup script downloads from here).
DOWNLOAD_URL=https://github.com/wmsid/trying/raw/main/bin
