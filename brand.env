# ---- Edit these, then run scripts/build.sh ----
# CLI / service / config-dir name (lowercase, no spaces). Replaces "netbird".
BRAND_NAME=slbzt
# Name shown in messages and as the Windows service display name.
BRAND_DISPLAY=SLBZT
# Your NetBird management server. Baked in as the default, so users never type it.
MGMT_URL=https://vpn.example.com:443
# Upstream NetBird release to build from.
NETBIRD_VERSION=v0.82.0
# Version string for your build.
BUILD_VERSION=1.0.0

# --- Coexistence with a stock NetBird install (must differ from NetBird's wt0 / utun100 / 51820) ---
WG_IFACE=slbzt0
WG_IFACE_DARWIN=utun150
WG_PORT=51821
