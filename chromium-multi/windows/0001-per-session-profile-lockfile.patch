 const char kLockfile[] = "lockfile";
 
+// Multi-session: the cross-machine lockfile name gets the Windows session id
+// appended, so one Chrome per RDP/console session can use the same profile.
+// (The singleton message window and startup mutex are already per-session.)
+std::string SessionLockfileName() {
+  DWORD session_id = 0;
+  if (!::ProcessIdToSessionId(::GetCurrentProcessId(), &session_id))
+    return kLockfile;
+  return base::StringPrintf("%s.s%lu", kLockfile,
+                            static_cast<unsigned long>(session_id));
+}
